# AccessBridge configuration
ENVIRONMENT=development

# Gemini is the primary semantic understanding engine.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server
HOST=127.0.0.1
PORT=8000
DEMO_PORT=8080
FRONTEND_PORT=5173

# Safety
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.65
MANDATORY_CONFIRMATION_FOR_HIGH_RISK=true

# Browser
DEFAULT_BROWSER_ENGINE=playwright
HEADLESS_BROWSER=true

# Storage
CHROMA_PERSIST_DIRECTORY=./data/chroma
AUDIT_DB_PATH=./data/audit.db
